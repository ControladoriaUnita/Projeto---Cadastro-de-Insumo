# Copie para .env.local (ignorado pelo git) e preencha.

# ---------------------------------------------------------------
# Client-side (vão para o bundle; só servem para o login)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Server-side (Vercel Functions) — NUNCA prefixar com VITE_
# ---------------------------------------------------------------
# memory   -> solicitações em memória + usuários de demonstração (desenvolvimento)
# supabase -> banco Supabase (produção)
DATA_SOURCE=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# mock -> catálogo de insumos de exemplo, nada sai do computador
# real -> API UAU (Globaltec/Senior)
UAU_MODE=mock
UAU_BASE_URL=https://gamma-api.seniorcloud.com.br:51572/uauAPI
UAU_INTEGRATION_TOKEN=
UAU_LOGIN=
# Use aspas simples se a senha tiver aspas duplas ou caracteres especiais
UAU_PASSWORD=''

# simulacao -> a aprovação valida e mostra o JSON, mas NÃO grava no UAU
# real      -> a aprovação insere o insumo (InserirInsumosGeral) e confirma (AtualizarInsumosGeral)
# A API não exclui insumos: um cadastro errado só pode ser inativado.
UAU_GRAVACAO=simulacao

# Libera o modo memória na Vercel (só para demonstração)
ALLOW_DEMO_MODE=false

# ---------------------------------------------------------------
# Avisos por e-mail (insumo aprovado → solicitante, analista e cópia fixa)
# ---------------------------------------------------------------
# none  -> desligado
# log   -> o e-mail aparece só no terminal do servidor (desenvolvimento)
# graph -> envio real pelo Microsoft 365 (aplicativo no Entra ID com permissão Mail.Send)
EMAIL_PROVIDER=log
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Caixa que envia, ex.: cadastro@unitaengenharia.com.br
EMAIL_SENDER=
# Sempre em cópia nos avisos de aprovação (separados por vírgula)
EMAIL_APPROVAL_CC=
# Endereço do app, para o link "Ver solicitação" no e-mail
APP_URL=http://localhost:5174
